---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
  numbered?: boolean;
}

const { entries, numbered = false } = Astro.props;
const entrySlug = (id: string) => id.replace(/\.md$/, '').split('/').at(-1) ?? id;
---

<ol class:list={['work-list', numbered && 'is-numbered']} data-work-list>
  {
    entries.map((entry, index) => {
      const year = entry.data.date.getUTCFullYear();
      const n = String(index + 1).padStart(2, '0');
      return (
        <li class:list={[index === 0 && 'is-first-visible']} data-category={entry.data.category}>
          <a href={`/work/${entrySlug(entry.id)}`}>
            <span class="work-title">{entry.data.title}</span>
            <span class:list={['year', numbered && index === 0 && 'year-mint']}>
              {numbered ? n : year}
            </span>
          </a>
        </li>
      );
    })
  }
</ol>
